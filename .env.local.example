# MongoDB (dev: docker run -d --name mongo-dev -p 27017:27017 -v mongo-data:/data/db mongo:7)
# Option A: MongoDB Atlas (cloud)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/portfolio?retryWrites=true&w=majority
# Option B: Docker / Local
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000

# Admin account (created by npm run seed)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# GitHub username for the stats strip + repo links
NEXT_PUBLIC_GITHUB_USERNAME=your-github-username

# Optional — Cloudinary uploads in the admin (uploads disabled without these)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SEO base URL (set on Vercel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000